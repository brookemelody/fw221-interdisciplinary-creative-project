@page "/silent-spring"
@rendermode InteractiveServer

<PageTitle>Silent Spring</PageTitle>

<details open>
    <summary>Information</summary>
    <section>
        <h1>Silent Spring</h1>
        <img src="https://upload.wikimedia.org/wikipedia/en/a/ac/SilentSpring.jpg" alt="Original cover of the book Silent Spring by Rachel Carson" />
        <p>Popular culture can also strongly influence public perceptions of conservation and environmental justice. One notable example is the 1962 book <em>Silent Spring</em> by American marine biologist and conservationist Rachel Carson.</p>
        <p><em>Silent Spring</em> exposed how overuse of the pesticide DDT resulted in harm to the environment. The title of the book refers to how DDT directly caused the deaths of so many birds and wildlife that the spring was devoid of the natural sounds that these wildlife would normally be making [<NavLink href="#1">1</NavLink>].</p>
        <p>In the book, Carson specifically accused the chemical industry of deliberately spreading disinformation to mislead the public into believing that indiscriminate use of synthetic pesticides such as DDT was not harmful to ecosystems as well as human health. Due to this, many representatives of chemical industries were outraged by <em>Silent Spring</em> and threatened legal retribution against Carson as well as accusing her as being hysterical [<NavLink href="#2">2</NavLink>].</p>
        <p>Despite the challenges presented by such a dedicated public and legal campaign against it, <em>Silent Spring</em> was able to make such a profound impact on the public that it led to a reversal in US pesticide policy, a nationwide ban on DDT for agricultural uses, and the creation of the US Environmental Protection Agency (EPA) [<NavLink href="#3">3</NavLink>].</p>

        <section>
            <h2>Bibliography</h2>
            <ol>
                <li id="1">
                    Carson, Rachel. “Silent Spring—I.” The New Yorker, 9 June 1962, www.newyorker.com/magazine/1962/06/16/silent-spring-part-1.
                </li>
                <li id="2">
                    NRDC. “The Story of Silent Spring.” NRDC, 13 Aug. 2015, www.nrdc.org/stories/story-silent-spring.
                </li>
                <li id="3">
                    US EPA, OA. “The Birth of EPA.” Www.epa.gov, Nov. 1985, www.epa.gov/archive/epa/aboutepa/birth-epa.html.
                </li>
            </ol>
        </section>
    </section>
</details>

<details open>
    <summary>Quiz</summary>
    <section>
        <h1>Quiz</h1>
<p role="status">Current score: @score</p>

@if(!quizFinished)
{
    <h2><span>@(currentQuestionIdx + 1). </span>@((MarkupString)quizQuestions[currentQuestionIdx].Question)</h2> @* It's nice that Blazor's state management seems to be quite straightforward to work with! *@ 
    @if (status is not null)
    {
        <p class="@(status.StartsWith("Correct") ? "text-success" : "text-danger")">@status</p>
    }
    <fieldset disabled="@disableAnswer">
        <InputRadioGroup @bind-Value="userAnswer" class="d-flex flex-column gap-1">
            @foreach (string answerChoice in quizQuestions.ElementAt(currentQuestionIdx).AnswerChoices)
            {
                <section class="d-flex gap-1">
                    <InputRadio class="form-check-input" id="@answerChoice" Value="@answerChoice" />
                    <label class="form-check-label" for="@answerChoice">@answerChoice</label>
                </section>
            }
        </InputRadioGroup>
    </fieldset>

    @if(!disableAnswer)
    {
        <button class="btn btn-primary" @onclick="AnswerQuestion">Check</button>
    }
    else
    {
        <button class="btn btn-primary" @onclick="GoToNextQuestion">Next Question</button>
    }

}
else
{
    <h2>Quiz Results: </h2>
    <p><span>@score</span>/<span>@quizQuestions.Count</span> - <span>@((double) score / quizQuestions.Count * 100)</span>%</p>
}
    </section>
</details>

@code {
    private bool quizFinished = false;
    private int score = 0;
    private List<QuizQuestion> quizQuestions = new List<QuizQuestion>();
    private int currentQuestionIdx = 0;
    private string userAnswer = "";
    private string? status;
    private bool disableAnswer = false;

    protected override void OnInitialized()
    {
        quizQuestions.Add(new QuizQuestion(
            "Which pesticide did Rachel Carson focus on in her book <em>Silent Spring</em>?",
            ["Methyl Bromide", "DDT", "Chlorpyrifos", "2,4-D"],
            1
        ));

        quizQuestions.Add(new QuizQuestion(
            "The heightened awareness of environmental issues among the general public brought by <em>Silent Spring's</em> impact directly led to which of the following consequences?",
                ["The creation of the Environmental Protection Agency (EPA)", "Accusing chemical companies of spreading disinformation became legally protected under freedom of speech", "A nationwide ban on DDT for warfare uses", "Nothing"],
            0
        ));

        quizQuestions.Add(new QuizQuestion(
            "<strong>True or False:</strong> The immediate response of the chemical industry to Carson's accusations in <em>Silent Spring</em> was one of acquiesce.",
            ["True", "False"],
            1
        ));
    }

    private void AnswerQuestion()
    {
        QuizQuestion currentQuestion = quizQuestions[currentQuestionIdx];
        bool correctlyAnswered = false;
        if (userAnswer.Equals(currentQuestion.AnswerChoices[currentQuestion.CorrectAnswerIdx]) && !quizFinished) {
            score++;
            correctlyAnswered = true;
        }

        if (correctlyAnswered)
        {
            status = "Correct answer!";
        }
        else
        {
            status = "Wrong answer!";
        }

        disableAnswer = true;
    }

    private void GoToNextQuestion()
    {
        currentQuestionIdx++;
        status = null;
        disableAnswer = false;

        // Finish the quiz if the current question was the last question
        if (currentQuestionIdx == quizQuestions.Count)
        {
            quizFinished = true;
        }
    }

    public class QuizQuestion
    {
        public string Question { get; set; }
        public string[] AnswerChoices { get; set; }
        public int CorrectAnswerIdx { get; set; }

        public QuizQuestion(string Question, string[] AnswerChoices, int CorrectAnswerIdx)
        {
            this.Question = Question;
            this.AnswerChoices = AnswerChoices;
            this.CorrectAnswerIdx = CorrectAnswerIdx;
        }
    }
}
